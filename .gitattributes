# Line endings: text files are stored as LF in the repo and checked out
# as LF on every OS, so Windows and macOS never fight over CRLF vs LF.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unity text assets (needs Asset Serialization = Force Text)
*.cs          text eol=lf diff=csharp
*.meta        text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.asset       text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.asmdef      text eol=lf
*.shader      text eol=lf
*.json        text eol=lf
*.md          text eol=lf

# Small images kept as standard binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary

# Large binary assets stored with Git LFS
*.blend  filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.mb     filter=lfs diff=lfs merge=lfs -text
*.max    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.hdr    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text

# Other small binary media, fonts, plugins, packages
*.mp3          binary
*.ogg          binary
*.ttf          binary
*.otf          binary
*.dll          binary
*.so           binary
*.dylib        binary
*.unitypackage binary
*.zip          binary
*.pdf          binary